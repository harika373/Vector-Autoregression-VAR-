      "source": [
        "\"\"\"\n",
        "PM2.5 forecasting using Vector Autoregression (VAR)\n",
        "Input: Data.xlsx\n",
        "Target: PM2.5\n",
        "Variables: PM2.5, RH, WD, SR, BP, AT\n",
        "Evaluation: MSE, MAPE, RMSE, R-squared\n",
        "\"\"\"\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from statsmodels.tsa.api import VAR\n",
        "from sklearn.metrics import (\n",
        "    mean_squared_error,\n",
        "    mean_absolute_percentage_error,\n",
        "    r2_score,\n",
        ")\n",
        "\n",
        "FILE_PATH = \"Data.xlsx\"\n",
        "COLUMNS = [\"PM2.5\", \"RH\", \"WD\", \"SR\", \"BP\", \"AT\"]\n",
        "TEST_FRACTION = 0.20\n",
        "MAX_LAGS = 10\n",
        "\n",
        "def main():\n",
        "    # Load and select the project columns; ignore extra blank Excel columns.\n",
        "    raw = pd.read_excel(FILE_PATH)\n",
        "    missing_columns = [c for c in COLUMNS if c not in raw.columns]\n",
        "    if missing_columns:\n",
        "        raise ValueError(f\"Missing required columns: {missing_columns}\")\n",
        "\n",
        "    data = raw[COLUMNS].apply(pd.to_numeric, errors=\"coerce\")\n",
        "\n",
        "    # Interpolate missing values in row order. This assumes rows are chronological.\n",
        "    data = data.interpolate(method=\"linear\", limit_direction=\"both\").dropna()\n",
        "    data = data.reset_index(drop=True)\n",
        "\n",
        "    if len(data) <= MAX_LAGS + 10:\n",
        "        raise ValueError(\"Not enough rows for VAR lag selection.\")\n",
        "\n",
        "    split = int(len(data) * (1 - TEST_FRACTION))\n",
        "    train = data.iloc[:split].copy()\n",
        "    test = data.iloc[split:].copy()\n",
        "\n",
        "    print(f\"Rows after preprocessing: {len(data)}\")\n",
        "    print(f\"Training rows: {len(train)}\")\n",
        "    print(f\"Testing rows: {len(test)}\")\n",
        "    print(\"\\nMissing values after preprocessing:\")\n",
        "    print(data.isna().sum())\n",
        "\n",
        "    # Select the lag order with BIC using only training data.\n",
        "    var_model = VAR(train)\n",
        "    order_results = var_model.select_order(maxlags=MAX_LAGS)\n",
        "    print(\"\\nLag order selection:\")\n",
        "    print(order_results.summary())\n",
        "    lag = order_results.selected_orders[\"bic\"]\n",
        "    if lag is None or lag < 1:\n",
        "        lag = 1\n",
        "    print(f\"\\nSelected lag by BIC: {lag}\")\n",
        "\n",
        "    fitted = var_model.fit(lag)\n",
        "    print(f\"VAR model stable: {fitted.is_stable()}\")\n",
        "    print(\"\\nModel summary:\")\n",
        "    print(fitted.summary())\n",
        "\n",
        "    # Rolling one-step-ahead evaluation with fixed coefficients.\n",
        "    # At each test step, previous actual observations are available.\n",
        "    predictions = []\n",
        "    for i in range(len(test)):\n",
        "        history = data.iloc[:split + i]\n",
        "        forecast = fitted.forecast(\n",
        "            y=history.to_numpy()[-lag:],\n",
        "            steps=1\n",
        "        )\n",
        "        predictions.append(forecast[0, 0])\n",
        "\n",
        "    actual = test[\"PM2.5\"].to_numpy()\n",
        "    predicted = np.asarray(predictions)\n",
        "\n",
        "    mse = mean_squared_error(actual, predicted)\n",
        "    mape = mean_absolute_percentage_error(actual, predicted) * 100\n",
        "    rmse = np.sqrt(mse)\n",
        "    r2 = r2_score(actual, predicted)\n",
        "\n",
        "    metrics = pd.DataFrame({\n",
        "        \"Metric\": [\"MSE\", \"MAPE (%)\", \"RMSE\", \"R-squared\"],\n",
        "        \"Value\": [mse, mape, rmse, r2]\n",
        "    })\n",
        "    print(\"\\n===== TEST RESULTS =====\")\n",
        "    print(metrics.to_string(index=False, formatters={\"Value\": \"{:.6f}\".format}))\n",
        "\n",
        "    results = pd.DataFrame({\n",
        "        \"Test_Row_Number\": np.arange(split + 1, split + len(test) + 1),\n",
        "        \"Actual_PM2.5\": actual,\n",
        "        \"Predicted_PM2.5\": predicted,\n",
        "        \"Error_Actual_Minus_Predicted\": actual - predicted\n",
        "    })\n",
        "    results.to_excel(\"VAR_PM25_Results.xlsx\", index=False)"
      ]
    },
